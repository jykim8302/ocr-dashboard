@echo off
title Mouse Tracer - raw input mouse recorder
setlocal
set "DIR=%~dp0"
set "PY=%DIR%mouse_tracer.py"

echo.
echo  ============================================
echo   Mouse Tracer  -  raw input mouse recorder
echo  ============================================
echo.
echo  Preparing program file...

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
 "$l = Get-Content -LiteralPath '%~f0' -Encoding ASCII;" ^
 "$i = [Array]::IndexOf($l, '#####PAYLOAD#####');" ^
 "if ($i -lt 0) { exit 1 };" ^
 "$b = ($l[($i+1)..($l.Count-1)]) -join '';" ^
 "$new = [Convert]::FromBase64String($b);" ^
 "if (Test-Path -LiteralPath '%PY%') {" ^
 "  $md5 = [Security.Cryptography.MD5]::Create();" ^
 "  $a = [BitConverter]::ToString($md5.ComputeHash([IO.File]::ReadAllBytes('%PY%')));" ^
 "  $c = [BitConverter]::ToString($md5.ComputeHash($new));" ^
 "  if ($a -ne $c) {" ^
 "    Copy-Item -LiteralPath '%PY%' -Destination '%PY%.bak' -Force;" ^
 "    Write-Host '  NOTE: your edited mouse_tracer.py was kept as mouse_tracer.py.bak'" ^
 "  }" ^
 "};" ^
 "[IO.File]::WriteAllBytes('%PY%', $new)"

if not exist "%PY%" goto :extract_failed

set "PYEXE="
for %%C in (pythonw python) do (
  if not defined PYEXE (
    %%C -c "import sys" >nul 2>&1 && set "PYEXE=%%C"
  )
)
if not defined PYEXE (
  py -3 -c "import sys" >nul 2>&1 && set "PYEXE=py -3"
)
if not defined PYEXE goto :no_python

echo  Starting...
start "" %PYEXE% "%PY%"
timeout /t 2 >nul
exit /b 0

:no_python
echo.
echo  [!] Python 3 was not found on this PC.
echo.
echo      Download: https://www.python.org/downloads/
echo      During install, CHECK "Add python.exe to PATH".
echo.
choice /C YN /M "Install Python automatically with winget now"
if errorlevel 2 goto :end
winget install -e --id Python.Python.3.12 --accept-source-agreements --accept-package-agreements
echo.
echo  Install finished. Please close this window and double-click this file again.
pause
exit /b 0

:extract_failed
echo.
echo  [!] Could not create mouse_tracer.py
echo      Try copying this file to your Desktop and running it again.
pause
exit /b 1

:end
pause
exit /b 0

